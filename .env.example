# Supabase 프로젝트 설정 > API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Auth.js. AUTH_SECRET은 `npx auth secret` 또는 임의의 긴 문자열
AUTH_SECRET=
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID
# 리디렉션 URI: https://<도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Vercel 밖(직접 서버, 프록시 뒤)에서 돌릴 때 true
AUTH_TRUST_HOST=true

# 선택: 로그인을 허용할 Google 계정, 쉼표로 구분. 비워두면 모든 Google 계정 허용
ALLOWED_EMAILS=

# 선택: 다른 기기(Tailscale 등)에서 개발 서버에 접속할 호스트, 쉼표로 구분
ALLOWED_DEV_ORIGINS=
